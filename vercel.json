{
    "version": 2,
    "functions": {
          "api/pipsend.js": { "maxDuration": 15 }
    },
    "routes": [
          { "src": "^/api/pipsend(.*)", "dest": "/api/pipsend?_path=$1" },
          { "src": "^/$",              "dest": "/fxte.html"      },
          { "src": "^/fxte/?$",       "dest": "/fxte.html"      },
          { "src": "^/overview/?$",   "dest": "/overview.html"  },
          { "src": "^/audit/?$",      "dest": "/audit.html"     },
          { "src": "^/ranking/?$",    "dest": "/ranking.html"   },
          { "src": "^/symbol/?$",     "dest": "/symbol.html"    },
          { "src": "^/market/?$",     "dest": "/market.html"    },
          { "src": "^/operation/?$",  "dest": "/operation.html" },
          { "src": "^/alert/?$",      "dest": "/alert.html"     },
          { "handle": "filesystem" }
    ]
}
